{
  "rewrites": [
    {
      "source": "/reisevorlage.html",
      "has": [
        { "type": "query", "key": "reise" },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|LinkedInBot|Discordbot|SkypeUriPreview|Applebot|Pinterest|Googlebot|bingbot|DuckDuckBot).*"
        }
      ],
      "destination": "/api/reise"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
