{
  "rewrites": [
    {
      "source": "/reisevorlage.html",
      "has": [{ "type": "query", "key": "reise", "value": "(?<reise>.+)" }],
      "destination": "/api/reisetagebuch?alt=:reise"
    },
    { "source": "/reisetagebuch/:land/:slug", "destination": "/api/reisetagebuch?land=:land&slug=:slug" },
    { "source": "/reisetagebuch/:land", "destination": "/api/reisetagebuch?land=:land" },
    { "source": "/reisetagebuch", "destination": "/api/reisetagebuch" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/testen", "destination": "/testen.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/fonts/(.*)\\.woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
